# Copy to .env for local development; configure production secrets on your host.
# Replace issuer/origins with the values for the Clerk instance used by index.html.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:8000,http://127.0.0.1:8000
CLERK_SECRET_KEY=
# Optional Clerk PEM public key, with literal \n between lines; otherwise JWKS is fetched.
CLERK_JWT_PUBLIC_KEY=
# Set only when the session tokens used by this deployment contain an audience.
CLERK_AUDIENCE=

MONGO_URI=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Generate a unique random admin token of at least 32 characters. Keep it server-side.
VYOM_ADMIN_TOKEN=

# Generate a fresh pair on the deployment host using scripts/generate_vapid_keys.py.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=
VAPID_SUBJECT=mailto:operator@example.com

SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Point only to a trusted official CAP feed that supplies polygon/circle coverage.
DISASTER_CAP_FEED_URL=
DISASTER_ENABLE_NWS=1
VYOM_USER_AGENT=VYOM/1.0 contact=operator@example.com
